FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

momentumSource
{
    type            meanVelocityForce;
    active          true;
    selectionMode   all;
    fields          (U);

    // Must match MeanVelocityMPerS in output/hollow-cylinder.physical-case.json.
    // validate_annulus.py --check-inputs compares them and refuses to run if they
    // drift, because a stale value here silently biases every comparison.
    Ubar            (0.00883932269380431 0 0);
}
