FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D axisymmetric wedge: one cell in the tangential direction, axial
// periodicity, a thin 2 degree sector. The previous case used a 30 degree
// section in three cells; its end faces were polygons with sin(10 deg)/10 deg
// = 0.507 % less area than the annulus, which went straight into the flow-rate
// label. A single 2 degree chord has sin(2 deg)/2 deg = 0.0203 % area defect,
// measured and reported by validate_annulus.py rather than assumed away.
//
// A finite wedge is still a polygon, not a circle: the wedge patch type removes
// the tangential periodicity, it does not make the area defect zero.

halfAngle   1;

// Must match output/hollow-cylinder.physical-case.json (reconstructed radii).
// validate_annulus.py checks these, the length, the viscosity and the full
// imposed velocity vector against the record before the mesh is built.
Ri          0.007999341770415122;
Ro          0.010000006675720215;
L           0.05;
Rmid        #eval{ ($Ri + $Ro)/2 };

sinHA       #eval{ sin(degToRad($halfAngle)) };
cosHA       #eval{ cos(degToRad($halfAngle)) };

yi          #eval{ $Ri * $sinHA };
zi          #eval{ $Ri * $cosHA };
ym          #eval{ $Rmid * $sinHA };
zm          #eval{ $Rmid * $cosHA };
yo          #eval{ $Ro * $sinHA };
zo          #eval{ $Ro * $cosHA };

nX          80;
nR1         50;
nR2         50;
nAng        1;

gR1         1.5;
gR2         0.6666666667;

vertices
(
    // η=0 (R_i)
    (0           $yi    $zi)    // 0
    ($L          $yi    $zi)    // 1
    ($L         -$yi    $zi)    // 2
    (0          -$yi    $zi)    // 3
    // η=1 (R_mid)
    (0           $ym    $zm)    // 4
    ($L          $ym    $zm)    // 5
    ($L         -$ym    $zm)    // 6
    (0          -$ym    $zm)    // 7
    // η=2 (R_o)
    (0           $yo    $zo)    // 8
    ($L          $yo    $zo)    // 9
    ($L         -$yo    $zo)    // 10
    (0          -$yo    $zo)    // 11
);

blocks
(
    hex (0 1 5 4 3 2 6 7) ($nX $nR1 $nAng) simpleGrading (1 $gR1 1)
    hex (4 5 9 8 7 6 10 11) ($nX $nR2 $nAng) simpleGrading (1 $gR2 1)
);

boundary
(
    cyclicLeft
    {
        type cyclic;
        neighbourPatch cyclicRight;
        faces
        (
            (0 4 7 3)
            (4 8 11 7)
        );
    }
    cyclicRight
    {
        type cyclic;
        neighbourPatch cyclicLeft;
        faces
        (
            (1 5 6 2)
            (5 9 10 6)
        );
    }
    innerWall
    {
        type wall;
        faces
        (
            (0 1 2 3)
        );
    }
    outerWall
    {
        type wall;
        faces
        (
            (8 9 10 11)
        );
    }
    wedgeFront
    {
        type wedge;
        faces
        (
            (0 1 5 4)
            (4 5 9 8)
        );
    }
    wedgeBack
    {
        type wedge;
        faces
        (
            (3 2 6 7)
            (7 6 10 11)
        );
    }
);

